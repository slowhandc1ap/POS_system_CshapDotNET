<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ERP_BurgerKorn</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .bg-orange {
            background-color : #ff6f00;
            color: white
        }

        .bg-orange .nav-link {
            color: white;
        }

        .bg-orange .nav-link:hover {
            background-color: #e65100;
                    transition: background-color 0.2s ease-in-out;
        }
    </style>
</head>
<body>
    <div class="d-flex" style="min-height: 100vh;">

        <!-- Sidebar -->
        <nav id="sidebarMenu" class="collapse d-lg-block bg-orange sidebar collapse show" style="width: 200px;">
            <div class="d-flex flex-column p-3 text-white">
                <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                    <span class="fs-4"><i class="bi bi-shop"></i> BigBurg</span>
                </a>
                <hr>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door-fill"></i> Home
                        </a>
                    </li>
                    <li>
                        <a class="nav-link text-white" asp-controller="Customer" asp-action="Index">
                            <i class="bi bi-person-fill"></i> Customers
                        </a>
                    </li>
                    <li>
                        <a class="nav-link text-white" asp-controller="User" asp-action="Index">
                            <i class="bi bi-people-fill"></i> Users
                        </a>
                    </li>
                    <li>
                        <a class="nav-link text-white" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-gear-fill"></i> Settings
                        </a>
                    </li>
                </ul>
                <hr>
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="https://www.svgrepo.com/show/535711/user.svg" alt="" width="32" height="32" class="rounded-circle me-2">
                        <strong>@User.Identity?.Name ?? "Guest"</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="#">Profile</a></li>
                        <li><a class="dropdown-item" href="#">Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Sign out</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="flex-grow-1 p-4">
            <!-- Toggle Button (เฉพาะจอเล็ก) -->
            <button class="btn btn-outline-dark d-lg-none mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i> Menu
            </button>

            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted text-center py-3 bg-light">
        <div class="container">
            &copy; 2568 - ERP_BurgerKorn - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
