@model DashboardViewModel
@{
    ViewData["Title"] = "POS Dashboard";
}

<div class="container-fluid px-4">
    <!-- Header with Stats -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold text-primary">POS System Dashboard</h1>
            <p class="text-muted">Welcome back! Here's what's happening today.</p>
        </div>
        
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Today's Sales</h6>
                            <h3 class="mb-0">@Model.TotalSalesToday.ToString("C")</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="fas fa-dollar-sign text-success fa-2x"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-success bg-opacity-10 text-success">+ @Model.TotalOrdersToday orders</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="/Products" class="text-decoration-none">
                <div class="card card-hover border-start border-4 border-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Low Stock Items</h6>
                                <h3 class="mb-0">@Model.LowStockCount</h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded">
                                <i class="fas fa-box-open text-warning fa-2x"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <span class="badge bg-warning bg-opacity-10 text-warning">Needs attention</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-hover border-start border-4 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">New Customers</h6>
                            <h3 class="mb-0">@Model.NewCustomersToday</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="fas fa-user-plus text-info fa-2x"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-info bg-opacity-10 text-info">Today</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-hover border-start border-4 border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Top Selling</h6>
                            <h3 class="mb-0">@Model.TotalSalesToday</h3>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-3 rounded">
                            <i class="fas fa-star text-danger fa-2x"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-danger bg-opacity-10 text-danger">Hot item</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Modules Grid -->
    <div class="row g-4">
        <!-- Sales Module -->
        <div class="col-lg-4 col-md-6">
            <a href="/Sales" class="text-decoration-none">
                <div class="card card-hover h-100">
                    <div class="card-body p-0 overflow-hidden rounded">
                        <div class="position-relative">
                            <img src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" class="img-fluid w-100" style="height: 120px; object-fit: cover;" alt="Sales">
                            <div class="position-absolute top-0 start-0 p-3">
                                <h5 class="text-white mb-0">Sales</h5>
                            </div>
                        </div>
                        <div class="p-3">
                            <p class="text-muted mb-3">Process transactions and manage orders with our intuitive sales interface.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary bg-opacity-10 text-primary">Quick checkout</span>
                                <i class="fas fa-arrow-right text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Products Module -->
        <div class="col-lg-4 col-md-6">
            <a href="/Products" class="text-decoration-none">
                <div class="card card-hover h-100">
                    <div class="card-body p-0 overflow-hidden rounded">
                        <div class="position-relative">
                            <img src="https://images.unsplash.com/photo-1555529669-e69e7aa0ba9a?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" class="img-fluid w-100" style="height: 120px; object-fit: cover;" alt="Products">
                            <div class="position-absolute top-0 start-0 p-3">
                                <h5 class="text-white mb-0">Products</h5>
                            </div>
                        </div>
                        <div class="p-3">
                            <p class="text-muted mb-3">Manage your inventory, categories, and product catalog efficiently.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-success bg-opacity-10 text-success">@Model.TotalOrdersToday items</span>
                                <i class="fas fa-arrow-right text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Customers Module -->
        <div class="col-lg-4 col-md-6">
            <a href="/Customer" class="text-decoration-none">
                <div class="card card-hover h-100">
                    <div class="card-body p-0 overflow-hidden rounded">
                        <div class="position-relative">
                            <img src="https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" class="img-fluid w-100" style="height: 120px; object-fit: cover;" alt="Customers">
                            <div class="position-absolute top-0 start-0 p-3">
                                <h5 class="text-white mb-0">Customers</h5>
                            </div>
                        </div>
                        <div class="p-3">
                            <p class="text-muted mb-3">Manage your customer database, loyalty programs, and customer insights.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-info bg-opacity-10 text-info">@Model.NewCustomersToday total</span>
                                <i class="fas fa-arrow-right text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Reports Module -->
        <div class="col-lg-4 col-md-6">
            <a href="/Reports" class="text-decoration-none">
                <div class="card card-hover h-100">
                    <div class="card-body p-0 overflow-hidden rounded">
                        <div class="position-relative">
                            <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" class="img-fluid w-100" style="height: 120px; object-fit: cover;" alt="Reports">
                            <div class="position-absolute top-0 start-0 p-3">
                                <h5 class="text-white mb-0">Reports</h5>
                            </div>
                        </div>
                        <div class="p-3">
                            <p class="text-muted mb-3">Generate detailed sales reports and analytics for better decision making.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-warning bg-opacity-10 text-warning">Daily insights</span>
                                <i class="fas fa-arrow-right text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Balance Sheet Module -->
        <div class="col-lg-4 col-md-6">
            <a href="/BalanceSheet" class="text-decoration-none">
                <div class="card card-hover h-100">
                    <div class="card-body p-0 overflow-hidden rounded">
                        <div class="position-relative">
                            <img src="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" class="img-fluid w-100" style="height: 120px; object-fit: cover;" alt="Finance">
                            <div class="position-absolute top-0 start-0 p-3">
                                <h5 class="text-white mb-0">Balance Sheet</h5>
                            </div>
                        </div>
                        <div class="p-3">
                            <p class="text-muted mb-3">View financial statements, profit/loss reports, and cash flow analysis.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-danger bg-opacity-10 text-danger">Financials</span>
                                <i class="fas fa-arrow-right text-danger"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Settings Module -->
        <div class="col-lg-4 col-md-6">
            <a href="/Settings" class="text-decoration-none">
                <div class="card card-hover h-100">
                    <div class="card-body p-0 overflow-hidden rounded">
                        <div class="position-relative">
                            <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" class="img-fluid w-100" style="height: 120px; object-fit: cover;" alt="Settings">
                            <div class="position-absolute top-0 start-0 p-3">
                                <h5 class="text-white mb-0">Settings</h5>
                            </div>
                        </div>
                        <div class="p-3">
                            <p class="text-muted mb-3">Configure system preferences, users, and business settings.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">System</span>
                                <i class="fas fa-arrow-right text-secondary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Real-time clock script -->
<script>
    function updateClock() {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: 'numeric', second: 'numeric', hour12: true });
        document.getElementById('live-clock').textContent = timeStr;
    }
    setInterval(updateClock, 1000);
</script>

<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
</style>